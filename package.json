{
  "name": "turing-demo",
  "version": "0.0.1",
  "description": "React Dashboard Application",
  "private": true,
  "dependencies": {
    "dotenv": "^17.4.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.23.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.8.1",
    "dotenv-webpack": "^9.0.0",
    "html-webpack-plugin": "^5.6.0",
    "serve": "^14.2.0",
    "style-loader": "^3.3.3",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "serve": "node -e \"console.log('=== Environment Variables ==='); const fs=require('fs'); const env=require('dotenv').config({path:'.env'}).parsed||{}; Object.entries(env).filter(([k])=>k.startsWith('REACT_APP_')||k==='NODE_ENV').forEach(([k,v])=>console.log(k+': '+v)); console.log('=============================');\" && serve -s dist -l 3000 --no-request-logging"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
